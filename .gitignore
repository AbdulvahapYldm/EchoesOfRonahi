Config/DefaultEditorPerProjectUserSettings.ini

# =====================================================
# Keep Unreal Project File
# =====================================================
!*.uproject

# =====================================================
# Keep C++ Source Code
# =====================================================
!Source/
!Source/**

# =====================================================
# Keep Unreal Config Files
# Sadece projenin calismasi icin gereken, paylasilmasi gereken .ini'ler
# =====================================================
Config/*
!Config/DefaultEngine.ini
!Config/DefaultGame.ini
!Config/DefaultInput.ini
!Config/DefaultEditor.ini
!Config/DefaultGameplayTags.ini
!Config/Tags/
!Config/Tags/**

# =====================================================
# Keep Unreal Content
# Blueprint / Maps / Materials / Assets
# =====================================================
!Content/
!Content/**
!**/*.uasset
!**/*.umap